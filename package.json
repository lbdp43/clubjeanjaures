{
  "name": "club-jean-jaures",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npx vite",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss || true && cd client && npm install && npx vite build",
    "start": "node server/index.js",
    "postinstall": "npx prisma generate || true",
    "db:push": "npx prisma db push",
    "db:seed": "node server/prisma/seed.js",
    "db:generate": "npx prisma generate"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ical-generator": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "sharp": "^0.33.5",
    "uuid": "^10.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
