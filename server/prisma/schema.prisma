generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  visitor
  member
  moderator
  admin
}

enum UserStatus {
  active
  suspended
}

enum EventType {
  matinale
  afterwork
  formation
  conference
  special
}

enum PostType {
  post
  demande
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  role              Role       @default(visitor)
  status            UserStatus @default(active)
  passwordHash      String?    @map("password_hash")
  magicToken        String?    @map("magic_token")
  magicTokenExpires DateTime?  @map("magic_token_expires")
  googleId          String?    @map("google_id")
  onboardingDone    Boolean    @default(false) @map("onboarding_done")
  gdprConsentAt     DateTime?  @map("gdpr_consent_at")
  invitedBy         String?    @map("invited_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  lastLogin         DateTime?  @map("last_login")

  inviter       User?      @relation("Invitations", fields: [invitedBy], references: [id])
  invitees      User[]     @relation("Invitations")
  member        Member?
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  favorites     Favorite[] @relation("UserFavorites")
  favoritedBy   Favorite[] @relation("FavoritedMember")
  eventsCreated Event[]
  rsvps         Rsvp[]

  @@map("users")
  @@index([status])
  @@index([role])
}

model Member {
  id          String   @id @db.Uuid
  companyName String   @map("company_name")
  jobTitle    String   @map("job_title")
  sector      String?  @map("sector")
  phone       String
  address     String
  city        String?
  latitude    Float?
  longitude   Float?
  logoUrl     String?  @map("logo_url")
  photoUrl    String?  @map("photo_url")
  photos      Json     @default("[]")
  website     String?
  socialLinks Json     @default("{}") @map("social_links")
  description String?
  lookingFor  String?  @map("looking_for")
  canOffer    String?  @map("can_offer")
  visibility  Json     @default("{\"phone\":\"private\",\"email\":\"private\"}")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("members")
  @@index([sector])
}

model Event {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  type            EventType
  date            DateTime  @db.Date
  timeStart       String    @map("time_start")
  timeEnd         String?   @map("time_end")
  location        String
  description     String?
  speaker         String?
  createdBy       String?   @map("created_by") @db.Uuid
  recurrenceGroup String?   @map("recurrence_group") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  rsvps   Rsvp[]

  @@map("events")
  @@index([date])
  @@index([type])
}

model Post {
  id          String   @id @default(uuid()) @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  type        PostType @default(post)
  content     String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@map("posts")
  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
  @@index([userId])
}

model Favorite {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  user   User @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  member User @relation("FavoritedMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([userId, memberId])
  @@map("favorites")
  @@index([userId])
  @@index([memberId])
}

model ClubSettings {
  id           Int     @id @default(1)
  name         String  @default("Club de Jean Jaurès")
  description  String  @default("")
  logoUrl      String? @map("logo_url")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  address      String?
  publicAgenda Boolean @default(true) @map("public_agenda")

  @@map("club_settings")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
  @@index([userId])
}

model Upload {
  id        String   @id @default(uuid()) @db.Uuid
  data      Bytes
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("uploads")
}

model Rsvp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("rsvps")
  @@index([eventId])
  @@index([userId])
}
